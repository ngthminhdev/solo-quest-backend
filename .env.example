PORT=9000
APP_ENV=development
SERVICE_NAME=solo_quest_backend
DATABASE_URL=postgres://postgres@localhost:5432/soloquest?sslmode=disable
JWT_SECRET=change_me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
DEV_USER_EMAIL=minhthanh@gmail.com

LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_SLOW_OPERATION_MS=1500
IS_WRITE_LOG_TO_FILES=false
LOG_FILE_DIR=logs
LOG_FILE_FOLDER=solo_quest_backend
LOG_FILE_NAME=solo_quest_backend.log
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_MAX_BACKUPS=7

# AI Configuration
AI_ENABLED=false
AI_PROVIDER=openai                          # "openai" (default) or "gemini"

# OpenAI / OpenAI-compatible provider
AI_API_KEY=your_openai_compatible_api_key_here
AI_MODEL=mimo-v2.5-pro
AI_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
AI_TIMEOUT_SECONDS=10

# Gemini provider (used when AI_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash             # default: gemini-2.5-flash

# Quest Generation AI Configuration (optional, overrides defaults)
# For long-running preview generation with reasoning models like mimo-v2.5-pro
# AI_QUEST_TIMEOUT_SECONDS=300    # Defaults to AI_TIMEOUT_SECONDS if not set
# AI_QUEST_MAX_TOKENS=12000       # Defaults to 12000 if not set

# Dev-only database reset safety flag
# Set to "true" only when you want to reset the local dev database.
# Requires APP_ENV=development. Will refuse to run otherwise.
# Usage: ALLOW_DEV_DB_RESET=true make db-reset-dev
# ALLOW_DEV_DB_RESET=true

# Daily Quest Cron Configuration
DAILY_QUEST_CRON_ENABLED=false
DAILY_QUEST_CRON_TIME=04:00
DAILY_QUEST_CRON_BATCH_SIZE=5
DAILY_QUEST_CRON_TIMEZONE=Asia/Ho_Chi_Minh

# Firebase Cloud Messaging (FCM)
# Set FCM_ENABLED=true to enable push notifications
# Requires a Firebase project with Cloud Messaging enabled
FCM_ENABLED=false
FCM_PROJECT_ID=
# Path to Firebase service account key JSON file (use absolute path)
FCM_CREDENTIALS_PATH=
# Alternative: paste the JSON directly (not recommended for production)
FCM_CREDENTIALS_JSON=
# Dry run mode: validates messages without sending real notifications
FCM_DRY_RUN=true

# Notification Cron Configuration
# Sends FCM push notifications for quest reminders, snooze reminders,
# and reminder settings (water, break_time, daily_review, sleep, learning, movement).
NOTIFICATION_CRON_ENABLED=false
NOTIFICATION_CRON_INTERVAL_SECONDS=60
NOTIFICATION_CRON_BATCH_SIZE=5
NOTIFICATION_CRON_LOOKBACK_SECONDS=90
NOTIFICATION_CRON_TIMEZONE=Asia/Ho_Chi_Minh

