PORT=9000
APP_ENV=development
SERVICE_NAME=soloquest-backend
DATABASE_URL=postgres://postgres@localhost:5432/soloquest?sslmode=disable
JWT_SECRET=change_me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
GOOGLE_CLIENT_ID=your_google_client_id
DEV_USER_EMAIL=minhthanh@gmail.com

LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout
LOG_SLOW_OPERATION_MS=1500
IS_WRITE_LOG_TO_FILES=false
LOG_FILE_DIR=logs
LOG_FILE_FOLDER=soloquest-backend
LOG_FILE_NAME=soloquest-backend.log
LOG_FILE_MAX_SIZE_MB=50
LOG_FILE_MAX_BACKUPS=7
